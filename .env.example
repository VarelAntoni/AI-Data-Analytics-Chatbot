# ============================================================
# Database Configuration (PostgreSQL Docker)
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=analytics_db
DB_USER=postgres
DB_PASSWORD=postgrespassword

# Allowlist tabel yang boleh di-query AI via text-to-SQL (pisahkan koma).
# Tabel history chat (chat_sessions/chat_messages) sengaja TIDAK termasuk.
PG_ALLOWED_TABLES=transactions

# ============================================================
# Google Gemini API Key
# Dapatkan gratis di: https://aistudio.google.com/
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================
# Multi-Source Data (CSV/XLSX/JSON/Google Sheets dari URL)
# Daftarkan sumber di data_sources.json (lihat data_sources.example.json)
# ============================================================
# TTL cache fetch sumber file/sheet dalam detik (stale-on-error aktif)
DATA_SOURCE_REFRESH_SECONDS=300

# ============================================================
# RAG (ChromaDB) Tuning
# ============================================================
# Jumlah chunk teratas yang diambil saat similarity search
RAG_TOP_K=3
# Ambang jarak L2 maksimum: chunk dengan jarak di atas ini dibuang
RAG_MAX_DISTANCE=1.5
# Halaman PDF dengan teks kurang dari ini dianggap bergambar -> Gemini Vision
PDF_MIN_TEXT_CHARS=50
