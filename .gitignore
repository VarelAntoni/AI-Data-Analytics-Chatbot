# ==============================================================================
# Git Ignore Configuration - AI Data Analytics Chatbot
# ==============================================================================

# 1. Environment & Secret Keys (CRITICAL: Never commit API keys!)
.env
.env.local
.env.*.local
*.key
*.pem

# 2. Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# 3. Virtual Environment
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# 4. Local Vector Database (Generated locally by seed script)
chroma_db/

# 5. IDE & Editor Specific Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# 6. Temporary / Log Files
*.log
*.tmp
*.bak
